# ============================================================================
# StockSenseAI - Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================================

# ── SQL Server ───────────────────────────────────────────────────────────────
SA_PASSWORD=YourStrong!Password123
MSSQL_PID=Developer

# ── Backend API ──────────────────────────────────────────────────────────────
BACKEND_REDIS_CONNECTION=redis:6379
BACKEND_DB_CONNECTION=Server=sqlserver,1433;Database=StockDataDb;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True;
GROQ_API_KEY=your_groq_api_key_here
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b

# ── StockDataService ────────────────────────────────────────────────────────
STOCKDATA_REDIS_CONNECTION=redis:6379
STOCKDATA_DB_CONNECTION=Server=sqlserver,1433;Database=StockDataDb;User Id=sa;Password=YourStrong!Password123;TrustServerCertificate=True;

# API key for stockDataService authorization (generate a strong random string)
# All endpoints require this key via the X-Api-Key header
STOCKDATA_API_KEY=change-me-generate-a-strong-random-key-here